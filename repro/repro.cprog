//  ]
//  returns fd_dir
		NONFAILING(memcpy((void*)0x2000000105c0, "f2fs\000", 5));
		NONFAILING(memcpy((void*)0x200000010600, "./file0\000", 8));
		NONFAILING(memcpy((void*)0x200000000740, "nocheckpoint_merge", 18));
